AI_PROVIDER=agnes
AGNES_API_KEY=your-new-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.0-flash

# Free local transcription with whisper.cpp.
LOCAL_ASR_ENABLED=true
LOCAL_ASR_URL=http://127.0.0.1:8080
LOCAL_ASR_MODEL=small-q5_1

# Optional cloud fallback for uploaded meeting recordings.
# Groq has a free tier and is recommended for the Render deployment.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Use these instead when TRANSCRIPTION_PROVIDER=openai.
OPENAI_TRANSCRIPTION_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# To use OpenAI for both text and audio instead, set AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
